# ShumShufer Driving School Platform — Backend Environment Configuration

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shumshufer-db?schema=public"

# Application Environment & Server Port
NODE_ENV="development" # "development" | "production" | "test"
PORT=3005

# JWT Authentication Secrets (generate via `openssl rand -base64 32`)
JWT_ACCESS_SECRET=your_32_bit_random_access_secret_key_here
JWT_REFRESH_SECRET=your_32_bit_random_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated, e.g. "http://localhost:5173,https://yourdomain.com")
CORS_ORIGIN="*"

# Automated Background Jobs Scheduler (set to "false" to disable in worker-less environments)
ENABLE_BACKGROUND_JOBS="true"

# Chapa Payment Gateway (leave as test/mock for local sandbox testing)
CHAPA_API_URL="https://api.chapa.co/v1"
CHAPA_SECRET_KEY="CHASECK_TEST-mock"
CHAPA_WEBHOOK_SECRET="chapa_secret"