DATABASE_URL="postgresql://<username>:<password>@<db_host>/<db_name>"
NODE_ENV="development"
PORT=3000
JWT_ACCESS_SECRET=32_bit_randome_string # run ` openssl rand -base64 32 ` to generate token
JWT_REFRESH_SECRET=32_bit_randome_string # run ` openssl rand -base64 32 ` to generate token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d